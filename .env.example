# Copy this file to .env (same folder) and fill in your keys. Never put real keys in THIS file:
# .env.example is shared and committed; .env is git-ignored.

# ---------------------------------------------------------------------------
# AI provider
#   mock              -> deterministic built-in planner and dialogue, no network, no key.
#   openai_compatible -> real LLMs via OpenAI-compatible /chat/completions endpoints.
# ---------------------------------------------------------------------------
AI_PROVIDER=mock

# Providers are tried in this order; if one fails or is rate-limited, the next is used.
LLM_PROVIDER_ORDER=groq,gemini,openrouter

# Free tiers. Model names change often - check each provider's model list.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional extra provider called "custom" (any OpenAI-compatible endpoint). Add "custom" to the order to use it.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Reliability limits (free tiers are heavily rate-limited; keep these low).
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_MAX_CALLS_PER_MINUTE=10
LLM_MAX_DELIBERATIONS_PER_RUN=30

# ---------------------------------------------------------------------------
# Simulation
# ---------------------------------------------------------------------------
# Simulated seconds advanced per scheduler tick.
SIM_TICK_SECONDS=5
# Game Mode deadline in simulated seconds (10 minutes).
GAME_DEADLINE_SECONDS=600

# Real-time pacing (simulated seconds per real second). Game Mode at 2.0 = a 5-minute game.
SIM_AUTORUN=true
GAME_SIM_SPEED=2.0
DEFAULT_SIM_SPEED=4.0
SNAPSHOT_INTERVAL_SECONDS=60
PLAYER_REQUESTS_PER_SECOND=4
PLAYER_REQUEST_BURST=8

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/offscript.db
CORS_ORIGINS=http://localhost:5173
